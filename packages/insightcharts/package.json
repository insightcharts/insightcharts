{
  "name": "insightcharts",
  "version": "0.1.0",
  "description": "Composable, AI-native infographics and data stories for React, built on Apache ECharts.",
  "license": "Apache-2.0",
  "author": {
    "name": "Kyle Ledbetter",
    "url": "https://x.com/kyleledbetter"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/insightcharts/insightcharts.git",
    "directory": "packages/insightcharts"
  },
  "homepage": "https://github.com/insightcharts/insightcharts#readme",
  "bugs": {
    "url": "https://github.com/insightcharts/insightcharts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "infographics",
    "charts",
    "echarts",
    "react",
    "data-visualization",
    "data-storytelling",
    "scrollytelling",
    "shadcn",
    "ai"
  ],
  "files": [
    "dist",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core/index.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data/index.js"
    },
    "./story": {
      "types": "./dist/story.d.ts",
      "import": "./dist/story/index.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes/index.js"
    },
    "./manifest.json": "./manifest.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && node ../../scripts/fix-esm-extensions.mjs dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "echarts": ">=6.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "echarts": "^6.1.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
